<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	  <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <Version>1.3.2</Version>
	  <Authors>Sergi Ortiz Gomez</Authors>
	  <Company>DrUalcman</Company>
	  <Description>
		  A lightweight and efficient Blazor service for interacting with the Browser's **Geolocation API**.
	  </Description>
	  <Copyright>Free</Copyright>
	  <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <RepositoryUrl>https://github.com/drualcman/BlazorBasics.Maps</RepositoryUrl>
	  <PackageProjectUrl>https://github.com/drualcman/BlazorBasics.Maps</PackageProjectUrl>
	  <PackageTags>Components;Blazor;WebAssembly;Maps;Geolocation;</PackageTags>
	  <PackageReleaseNotes>
		  Every position request now carries a timeout, so a request that gets no answer from
		  the browser ends instead of waiting forever. Falls back to a low accuracy request
		  when the gps fix does not arrive. New IExtendedGeolocationService returns why a
		  reading failed (permission, unavailable, timeout, not supported, insecure context)
		  instead of a null position. Reading the permission no longer throws where
		  navigator.permissions does not exist.
	  </PackageReleaseNotes>
	  <RepositoryType>Git</RepositoryType>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
	
	<ItemGroup>
		<None Include="..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.18" Condition="'$(TargetFramework)' == 'net9.0'" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" Condition="'$(TargetFramework)' == 'net10.0'" />
	  <PackageReference Include="BlazorBasics.Maps.Entities" Version="1.2.0" />
  </ItemGroup>
	
</Project>
